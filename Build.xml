<project name="CMCLiteBans" default="Build">

    <!-- 1. Define where to put the plugin JAR -->
    <property name="plugin.dir" value="\Users\xxx\Desktop\Study\1.20.6 - 1.21.4 - 1.21.11\plugins\"/>

    <!-- 2. The main build target -->
    <target name="Build">
        <!-- Create the plugin JAR file directly in your server folder -->
        <jar jarfile="${plugin.dir}/${ant.project.name}.jar" basedir="./target/classes" includes="**/*">

            <!-- Include plugin.yml -->
            <fileset dir="src/main/resources" includes="plugin.yml"/>

            <!-- (Optional) If you wanted to include libraries inside the jar, you would do it here.
                 Since LiteBans/AuthMe are on the server already, we usually don't need zipgroupfileset here
                 unless you are shading something like 'Foundation'.
                 For this specific plugin, we likely keep it simple. -->
        </jar>

        <echo message="-------------------------------------------------"/>
        <echo message=" Build Complete! "/>
        <echo message=" Jar deployed to: ${plugin.dir}/${ant.project.name}.jar"/>
        <echo message="-------------------------------------------------"/>
    </target>


</project>
